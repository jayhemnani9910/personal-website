# ---- Local-only working material ----
# None of this is part of the website. Kept on disk, out of the repo.
# Always anchor these with a leading slash. A bare `resume/` once matched
# src/app/resume/ too, hid it from Tailwind's scanner, and shipped the About
# page with no CSS. The job-search and practice directories that used to sit
# here now live in ../job-search/ and ../competitive-coding/.
/docs/superpowers/


# Playwright visual regression. The baselines under tests/visual/__snapshots__
# ARE committed (they are the reference); these are per-run artefacts.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
