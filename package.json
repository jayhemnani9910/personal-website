{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:visual": "next build && playwright test --project=paper",
    "test:visual:update": "next build && playwright test --project=paper --update-snapshots",
    "test:visual:oss": "next build && playwright test --project=paper --update-snapshots --grep \"\\\\b(home|oss|oss-repo|resume) renders unchanged\" && playwright test --project=paper",
    "test:perf": "next build && playwright test --project=perf",
    "test:perf:ci": "playwright test --project=perf",
    "eval:fde": "FDE_EVAL_LIVE=1 vitest run src/lib/fde-eval.live.test.ts",
    "eval:fde:update": "FDE_EVAL_LIVE=1 FDE_EVAL_UPDATE=1 vitest run src/lib/fde-eval.live.test.ts",
    "ops": "node --env-file-if-exists=.env.production.local scripts/ops-report.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^14.7.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": {
        "argparse": "^2.0.1"
      }
    }
  }
}
