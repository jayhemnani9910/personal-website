# Copy to .env.local. Every variable is optional; the site runs without any.

# /api/fde-sim. Without it, /fde keeps its presets.
GEMINI_API_KEY=

# Views, guestbook, rate limits, model budget, FDE metrics.
# The older KV_REST_API_URL / KV_REST_API_TOKEN names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Key for hashing visitor IPs. Without it, a random key per instance.
IP_HASH_SECRET=

# npm run eval:fde / eval:fde:update
FDE_EVAL_ENDPOINT=
FDE_EVAL_DATE=
